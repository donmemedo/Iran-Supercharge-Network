# Edge proxy. Its main security job: it REPLACES any X-Forwarded-For a client sends with the real peer address
# (Caddy ignores forwarded headers from untrusted clients), so the per-client write limit can't be dodged by
# forging that header. Next.js alone would keep a client-sent value.
# Local default serves plain HTTP on :80 (published as 3020).
# Automatic HTTPS: set SITE_ADDRESS=your.domain together with FRONTEND_PORT=80 and HTTPS_PORT=443 (ACME needs both public ports).
# Behind a CDN or TLS proxy, set TRUSTED_PROXIES to its address ranges (space-separated CIDRs) so Caddy keeps the
# X-Forwarded-For it sends; otherwise every visitor looks like one CDN node. The default trusts nothing outside the container.
{
	admin off
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	@api path /api/*
	request_body @api {
		max_size 16KB
	}
	reverse_proxy frontend:3000
}
